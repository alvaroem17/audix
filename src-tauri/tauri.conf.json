{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audix",
  "version": "0.1.0",
  "identifier": "dev.alvaro.audix",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Audix",
        "width": 900,
        "height": 780,
        "minWidth": 620,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "Vídeo a audio y descargas de YouTube",
    "longDescription": "Convierte vídeos a audio (mp3, m4a, opus, ogg, flac, wav) y descarga vídeos o playlists de YouTube.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ]
      }
    }
  }
}
